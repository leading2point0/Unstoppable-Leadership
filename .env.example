# Application
NODE_ENV=development
APP_NAME="Unstoppable Action Lab"
APP_URL=http://localhost:3000
APP_VERSION=development

# Database (docker compose up -d starts a local Postgres matching this URL)
DATABASE_URL=postgresql://unstoppable:unstoppable@localhost:5432/unstoppable

# Authentication (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-secure-random-secret
AUTH_TRUST_HOST=true

# Owner bootstrap — set these, run `npm run bootstrap:owner` once, then remove them.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-before-use
BOOTSTRAP_OWNER_NAME="Site Owner"

# Registration
ALLOW_PUBLIC_REGISTRATION=false

# Email (password-reset delivery). Leave blank in development — the app
# will surface a clear "email not configured" message instead of pretending
# to have sent anything.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# Storage (evidence file uploads — disabled unless configured)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Security
RATE_LIMIT_ENABLED=true

# Optional monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
